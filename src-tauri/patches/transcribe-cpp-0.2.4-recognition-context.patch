+// Recognition context (Moqi patch, after PR #144): background text such as a
+// word list, tokenized as plain text into the system turn. Read only when the
+// caller's struct is new enough to carry the field; any encode failure just
+// means no context.
+std::vector<int32_t> context_tokens(const transcribe::Tokenizer & tok, const transcribe_run_params * params) {
+    std::vector<int32_t> ids;
+    if (params == nullptr ||
+        params->struct_size < offsetof(transcribe_run_params, context) + sizeof(params->context) ||
+        params->context == nullptr || params->context[0] == '\0') {
+        return ids;
+    }
+    if (tok.encode(params->context, ids) != TRANSCRIBE_OK) {
+        ids.clear();
+    }
+    return ids;
+}
